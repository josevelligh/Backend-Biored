# ---------------------------------------------------------------------------
# BioRed API — variables de entorno
# ---------------------------------------------------------------------------
# Si SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY quedan vacías, el servidor arranca
# en MODO DEMO (repositorio en memoria con los datos semilla de Managua).
# Esto permite levantar `npm run dev` al instante, sin credenciales.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Puerto del servidor de desarrollo local (la app Expo lo consume vía LAN)
PORT=3000
